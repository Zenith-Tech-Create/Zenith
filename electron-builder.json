{
  "appId": "com.zenith.app",
  "productName": "ZenithPersonnelLifeOS",
  "directories": {
    "output": "dist",
    "buildResources": "assets"
  },
  "files": [
    "main.js",
    "preload.js",
    "src/**/*",
    "node_modules/**/*",
    "package.json"
  ],

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "appx",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "certificateFile": null,
    "certificatePassword": null
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ZenithOS"
  },

  "appx": {
    "publisherDisplayName": "ZenithOS",
    "displayName": "Zenith Personnel Life OS",
    "identityName": "ZenithOS.ZenithPersonnelLifeOS",
    "publisher": "CN=2E19EAE5-432E-47BD-9A4F-4B29D29D67C4",
    "applicationId": "ZenithOS"
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "icon": "assets/electron.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "dmg": {
    "contents": [
      {
        "x": 110,
        "y": 150,
        "type": "file"
      },
      {
        "x": 240,
        "y": 150,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Utility"
  },
  "publish": {
    "provider": "github",
    "owner": "Zenith-Tech-Create",
    "repo": "Zenith"
  }
}
